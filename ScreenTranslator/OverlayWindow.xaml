<Window x:Class="ScreenTranslator.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" Cursor="Cross" AllowsTransparency="False"
        Background="Black" Title="Overlay" Focusable="True"
        KeyDown="OnKeyDown" MouseRightButtonDown="OnRightClick">
    <Canvas x:Name="RootCanvas"
            Background="Transparent"
            MouseLeftButtonDown="OnMouseDown"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseUp">
        <!-- 冻结的全屏截图（"暂停画面"效果） -->
        <Image x:Name="FrozenImage" Stretch="Fill" />
        <!-- 暗色遮罩 -->
        <Rectangle x:Name="DimLayer" Fill="#66000000" />
        <!-- 框选矩形 -->
        <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                   Stroke="#FF2196F3" StrokeThickness="2"
                   Fill="#332196F3" RadiusX="2" RadiusY="2" />
        <!-- 提示文字 -->
        <Border Background="#AA000000" CornerRadius="6" Padding="12,6"
                Canvas.Left="16" Canvas.Top="16">
            <TextBlock Foreground="White" FontSize="13"
                       Text="拖拽框选要翻译的区域，ESC 或右键 取消" />
        </Border>
    </Canvas>
</Window>
