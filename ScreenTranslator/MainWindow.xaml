<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTranslator 截图翻译" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="ScreenTranslator 截图翻译"
                   FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="翻译引擎:" VerticalAlignment="Center"/>
        <ComboBox x:Name="EngineBox" Grid.Row="1" Grid.Column="1" Margin="0,4"
                  SelectionChanged="OnEngineChanged">
            <ComboBoxItem Content="腾讯（每月500万字符免费）" Tag="tencent"/>
            <ComboBoxItem Content="百度（认证后每月100万字符免费）" Tag="baidu"/>
            <ComboBoxItem Content="DeepL（质量最高）" Tag="deepl"/>
            <ComboBoxItem Content="Google（免费，无需密钥）" Tag="google"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="源语言:" VerticalAlignment="Center"/>
        <ComboBox x:Name="SourceLangBox" Grid.Row="2" Grid.Column="1" Margin="0,4"
                  SelectionChanged="OnLangChanged"
                  ToolTip="自动识别对日文（含汉字）可能误判为中文，看日文内容时建议手动选日文">
            <ComboBoxItem Content="自动识别" Tag="auto"/>
            <ComboBoxItem Content="中文" Tag="zh"/>
            <ComboBoxItem Content="英文" Tag="en"/>
            <ComboBoxItem Content="日文" Tag="ja"/>
            <ComboBoxItem Content="韩文" Tag="ko"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="目标语言:" VerticalAlignment="Center"/>
        <ComboBox x:Name="TargetLangBox" Grid.Row="3" Grid.Column="1" Margin="0,4"
                  SelectionChanged="OnLangChanged">
            <ComboBoxItem Content="中文" Tag="zh"/>
            <ComboBoxItem Content="英文" Tag="en"/>
            <ComboBoxItem Content="日文" Tag="ja"/>
            <ComboBoxItem Content="韩文" Tag="ko"/>
        </ComboBox>

        <CheckBox x:Name="AutoStartCheck" Grid.Row="4" Grid.ColumnSpan="2"
                  Content="开机自动启动（启动后驻留右下角托盘）"
                  Margin="0,8,0,0" Click="OnAutoStartClick"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="打开配置文件" Padding="14,5"
                    ToolTip="用记事本打开 config.txt（填 API 密钥、改快捷键等）"
                    Click="OnOpenConfig" />
            <Button Content="立即截图翻译" Padding="14,5" Margin="8,0,0,0"
                    Click="OnTranslateNow" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="6" Grid.ColumnSpan="2"
                   Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"/>
    </Grid>
</Window>
