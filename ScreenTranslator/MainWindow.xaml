<ui:FluentWindow x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ScreenTranslator" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Win11 风格标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="ScreenTranslator"
                     Icon="pack://application:,,,/Assets/app.png"/>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：图标 + 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,16">
                <Image Source="pack://application:,,,/Assets/app.png"
                       Width="40" Height="40" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ScreenTranslator" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="快捷键截图 · 框选即译" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- 设置卡片 -->
            <ui:Card Grid.Row="1" Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="翻译引擎" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="EngineBox" Grid.Column="1"
                                  SelectionChanged="OnEngineChanged">
                            <ComboBoxItem Content="腾讯（每月 500 万字符免费）" Tag="tencent"/>
                            <ComboBoxItem Content="百度（认证后每月 100 万字符免费）" Tag="baidu"/>
                            <ComboBoxItem Content="DeepL（质量最高）" Tag="deepl"/>
                            <ComboBoxItem Content="Google（免费，无需密钥）" Tag="google"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="源语言" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="SourceLangBox" Grid.Column="1" Margin="0,0,12,0"
                                  SelectionChanged="OnLangChanged"
                                  ToolTip="自动识别对日文（含汉字）可能误判为中文，看日文内容时建议手动选日文">
                            <ComboBoxItem Content="自动识别" Tag="auto"/>
                            <ComboBoxItem Content="中文" Tag="zh"/>
                            <ComboBoxItem Content="英文" Tag="en"/>
                            <ComboBoxItem Content="日文" Tag="ja"/>
                            <ComboBoxItem Content="韩文" Tag="ko"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="目标语言" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="TargetLangBox" Grid.Column="3"
                                  SelectionChanged="OnLangChanged">
                            <ComboBoxItem Content="中文" Tag="zh"/>
                            <ComboBoxItem Content="英文" Tag="en"/>
                            <ComboBoxItem Content="日文" Tag="ja"/>
                            <ComboBoxItem Content="韩文" Tag="ko"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="AutoStartCheck"
                              Content="开机自动启动（启动后驻留右下角托盘）"
                              Click="OnAutoStartClick"/>
                </StackPanel>
            </ui:Card>

            <!-- 操作按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Padding="16,6"
                           ToolTip="用记事本打开 config.txt（填 API 密钥、改快捷键等）"
                           Click="OnOpenConfig">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentEdit20" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="配置文件"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Primary" Padding="16,6" Margin="10,0,0,0"
                           Click="OnTranslateNow">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Translate20" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="立即截图翻译"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>

            <!-- 状态栏 -->
            <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12"
                       Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
