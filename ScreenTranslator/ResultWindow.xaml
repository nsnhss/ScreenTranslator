<Window x:Class="ScreenTranslator.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="420" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        MaxHeight="400" Title="翻译结果">
    <Border Background="#FAFFFFFF" BorderBrush="#FF2196F3" BorderThickness="1"
            CornerRadius="8" Padding="12"
            MouseLeftButtonDown="OnDragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" />
        </Border.Effect>
        <StackPanel>
            <!-- 标题栏 -->
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="BadgeText" DockPanel.Dock="Left"
                           FontSize="11" Foreground="#FF2196F3" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton" DockPanel.Dock="Right"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnClose" ToolTip="关闭">
                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Foreground="Gray"/>
                </Button>
                <TextBlock Text="翻译结果" FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- 原文 -->
            <TextBlock Text="原文" FontSize="11" Foreground="Gray" />
            <TextBox x:Name="SourceText" IsReadOnly="True" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent"
                     FontSize="13" Margin="0,2,0,8" />

            <!-- 译文 -->
            <TextBlock Text="译文" FontSize="11" Foreground="Gray" />
            <TextBox x:Name="TargetText" IsReadOnly="True" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent"
                     FontSize="14" FontWeight="SemiBold" Margin="0,2,0,8" />

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制译文" Padding="10,4" Margin="4,0,0,0"
                        Cursor="Hand" Click="OnCopyTarget" />
                <Button Content="复制原文" Padding="10,4" Margin="4,0,0,0"
                        Cursor="Hand" Click="OnCopySource" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
